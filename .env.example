# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT uses LiveKit Inference with the LiveKit Cloud credentials above.

# TTS
RIME_API_KEY=

# Owned middleware
AMD_API_URL=https://owned-middleware.example
AMD_API_TOKEN=

# Product-owned AI interaction ingestion
ACUITY_PRODUCT_INTERACTION_URL=https://your-acuity-product.example/v1/ai/interactions
ACUITY_DEMO_PRODUCT_SERVICE_SECRET=
ABITA_EYE_GROUP_PRODUCT_SERVICE_SECRET=

# Product-owned human handoff for every production Office Profile
# Both route values are required together. Product resolves officeKey to Location.
# The service secret above is reused.
ACUITY_PRODUCT_HANDOFF_URL=https://your-acuity-product.example/v1/handoffs
ACUITY_PRODUCT_HANDOFF_PRACTICE_ID=

# Staff Task delivery to the Acuity portal (not call evidence)
ANALYTICS_URL=
LIVEKIT_FORWARD_SYNC_SECRET=

# Legacy direct Acuity call-center handoff fallback
# Both are required when Product handoff is not configured.
# The URL must use HTTPS.
ACUITY_HANDOFF_URL=
ACUITY_HANDOFF_SECRET=

# Optional: isolated dev transfer target override
# Values may be E.164 numbers, tel: URIs, or sip: URIs.
# DEV_HANDOFF_TARGET=

# Optional: isolated Acuity Product Staff Task delivery for the dev trunk.
# The task endpoint is derived from the handoff URL.
# DEV_ACUITY_HANDOFF_URL=https://your-acuity-product.example/v1/handoffs
# DEV_ACUITY_HANDOFF_SECRET=

# Optional: alternate prompt workspace path
PROMPT_WORKSPACE=workspace
