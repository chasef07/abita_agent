# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT uses LiveKit Inference with the LiveKit Cloud credentials above.

# TTS
RIME_API_KEY=

# Owned middleware
AMD_API_URL=https://owned-middleware.example
AMD_API_TOKEN=

# Product-owned AI interaction ingestion
ACUITY_PRODUCT_INTERACTION_URL=https://your-acuity-product.example/v1/ai/interactions
ACUITY_PRODUCT_SERVICE_SECRET=

# Staff Task delivery to the Acuity portal (not call evidence)
ANALYTICS_URL=
LIVEKIT_FORWARD_SYNC_SECRET=

# Direct Acuity call-center handoff
# Both are required for call-center offices.
# The URL must use HTTPS.
ACUITY_HANDOFF_URL=
ACUITY_HANDOFF_SECRET=

# Optional: demo transfer target override
# Values may be E.164 numbers, tel: URIs, or sip: URIs.
# DEV_HANDOFF_TARGET=

# Optional: route only the dev trunk through the Acuity Product demo.
# URL and secret deliver Staff Tasks; add both IDs to enable handoffs.
# When set, this takes precedence over DEV_HANDOFF_TARGET.
# DEV_ACUITY_HANDOFF_URL=https://your-acuity-product.example/v1/handoffs
# DEV_ACUITY_HANDOFF_SECRET=
# DEV_ACUITY_HANDOFF_PRACTICE_ID=
# DEV_ACUITY_HANDOFF_LOCATION_ID=

# Optional: alternate prompt workspace path
PROMPT_WORKSPACE=workspace
