# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM
BASETEN_API_KEY=

# STT
ASSEMBLYAI_API_KEY=

# TTS
CARTESIA_API_KEY=
# Optional: override the default English Cartesia voice
# CARTESIA_TTS_VOICE=a167e0f3-df7e-4d52-a9c3-f949145efdab

# AdvancedMD middleware
AMD_API_URL=https://advancedmd-token-management-production.up.railway.app
AMD_API_TOKEN=

# Post-call analytics
ANALYTICS_URL=
WEBHOOK_SECRET=

# Optional: transfer target overrides for human handoffs
# Values may be E.164 numbers, tel: URIs, or sip: URIs.
# SPRING_HILL_HANDOFF_TARGET=
# TELNYX_VOICE_API_HANDOFF_TARGET=
# HOLLYWOOD_HANDOFF_TARGET=
# SWEETWATER_HANDOFF_TARGET=

# Optional: alternate prompt workspace path
PROMPT_WORKSPACE=workspace
