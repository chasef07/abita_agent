# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM
BASETEN_API_KEY=

# STT
ASSEMBLYAI_API_KEY=

# TTS
RIME_API_KEY=

# AdvancedMD middleware
AMD_API_URL=https://advancedmd-token-management-production.up.railway.app
AMD_API_TOKEN=

# LiveKit call ingestion
# Use the Acuity portal endpoint, for example:
# ANALYTICS_URL=https://your-acuity-site.example/api/livekit/calls
ANALYTICS_URL=
LIVEKIT_FORWARD_SYNC_SECRET=
WEBHOOK_SECRET=

# Optional: direct Acuity call-center handoff
# Leave both blank to keep the current configured handoff targets.
# The URL must use HTTPS.
ACUITY_HANDOFF_URL=
ACUITY_HANDOFF_SECRET=
# When direct handoff is configured, phone fallback is disabled unless true.
ACUITY_HANDOFF_PHONE_FALLBACK_ENABLED=false

# Optional: transfer target overrides for human handoffs
# Values may be E.164 numbers, tel: URIs, or sip: URIs.
# SPRING_HILL_HANDOFF_TARGET=
# TELNYX_VOICE_API_HANDOFF_TARGET=
# HOLLYWOOD_HANDOFF_TARGET=
# SWEETWATER_HANDOFF_TARGET=

# Optional: alternate prompt workspace path
PROMPT_WORKSPACE=workspace
