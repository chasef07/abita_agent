# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM
BASETEN_API_KEY=

# Optional LiveKit Inference TTS overrides
INWORLD_TTS_MODEL_ID=inworld/inworld-tts-2
INWORLD_TTS_VOICE=Sarah
INWORLD_TTS_SPANISH_VOICE=Sarah

# AdvancedMD middleware
AMD_API_URL=https://advancedmd-token-management-production.up.railway.app
AMD_API_TOKEN=

# Post-call analytics
ANALYTICS_URL=
WEBHOOK_SECRET=

# Optional: alternate prompt workspace path
PROMPT_WORKSPACE=workspace
