# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: export recorded conversation and tool payloads to Google Cloud Trace.
# Leave both blank to disable. The collector uses a Google service identity.
# GOOGLE_CLOUD_TRACE_ENDPOINT=https://your-collector.run.app/v1/traces
GOOGLE_CLOUD_TRACE_ENDPOINT=
GOOGLE_CLOUD_TRACE_TOKEN=

# Required for direct AssemblyAI STT. LiveKit still owns audio turn detection.
ASSEMBLYAI_API_KEY=

# Primary Gemma and fallback DeepSeek V4 Pro LLMs use LiveKit Inference credentials above.

# TTS

# Owned middleware
AMD_API_URL=https://owned-middleware.example
AMD_API_TOKEN=

# Required for every demo office and named LiveKit deployment (including staging).
# A separate middleware service configured with AMD_ENV=dev and sandbox EMR credentials.
# Never reuse the production URL or token. EMR credentials belong to middleware only.
SANDBOX_AMD_API_URL=https://sandbox-middleware.example
SANDBOX_AMD_API_TOKEN=

# Product-owned AI interaction ingestion
ACUITY_PRODUCT_INTERACTION_URL=https://your-acuity-product.example/v1/ai/interactions
ACUITY_DEMO_PRODUCT_SERVICE_SECRET=
ACUITY_DEMO_PRODUCT_PRACTICE_ID=
ABITA_EYE_GROUP_PRODUCT_SERVICE_SECRET=
ABITA_EYE_GROUP_PRODUCT_PRACTICE_ID=

# Product-owned human handoff and Staff Tasks for all Office Profiles.
# Product resolves officeKey to a Location inside the selected Practice.
# Staff Tasks derive /v1/tasks and reuse the tenant service secrets above.
ACUITY_PRODUCT_HANDOFF_URL=https://your-acuity-product.example/v1/handoffs

# Legacy direct Acuity call-center handoff fallback
# Both are required when Product handoff is not configured.
# The URL must use HTTPS.
ACUITY_HANDOFF_URL=
ACUITY_HANDOFF_SECRET=

# Optional: isolated dev transfer target override
# Values may be E.164 numbers, tel: URIs, or sip: URIs.
# DEV_HANDOFF_TARGET=

# Optional: alternate prompt workspace path
PROMPT_WORKSPACE=workspace

# Required office knowledge search for every office. Reuses existing tenant credentials.
# Product must have a current imported corpus for each configured office route.
# Search failures remain explicit; there is no file-backed fallback or pilot flag.
ACUITY_PRODUCT_KNOWLEDGE_URL=https://your-acuity-product.example/v1/agent/knowledge/search
