{
  "name": "abita_agent",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js start",
    "download-files": "node dist/main.js download-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.1",
    "@livekit/agents-plugin-assemblyai": "1.4.1",
    "@livekit/agents-plugin-baseten": "^1.4.1",
    "@livekit/agents-plugin-cartesia": "1.4.1",
    "@livekit/agents-plugin-livekit": "^1.4.1",
    "@livekit/agents-plugin-silero": "^1.4.1",
    "@livekit/noise-cancellation-node": "^0.1.9",
    "@livekit/rtc-node": "^0.13.27",
    "dotenv": "^17.4.2",
    "livekit-server-sdk": "^2.15.2",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
