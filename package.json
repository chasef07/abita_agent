{
  "name": "abita_agent",
  "version": "5.3.4",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts dev",
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.check.json",
    "start": "node dist/main.js start",
    "download-files": "livekit-agents download-files",
    "greetings:generate": "node --env-file-if-exists=.env.local --import tsx scripts/generate-greetings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-assemblyai": "1.8.0",
    "@livekit/agents-plugin-krisp": "1.8.0",
    "@livekit/agents-plugin-rime": "1.8.0",
    "@livekit/rtc-node": "^0.13.34",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "double-metaphone": "2.0.1",
    "fast-fuzzy": "1.12.0",
    "livekit-server-sdk": "^2.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "vite": "8.2.2"
    }
  },
  "packageManager": "pnpm@10.34.3"
}
