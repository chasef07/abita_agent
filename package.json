{
  "name": "abita_agent",
  "version": "4.12.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js start",
    "download-files": "livekit-agents download-files",
    "test": "vitest run && pnpm test:office-knowledge-benchmark",
    "test:office-knowledge-benchmark": "tsx src/__tests__/office-knowledge-benchmark.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@livekit/agents": "1.7.0",
    "@livekit/agents-plugin-rime": "1.7.0",
    "@livekit/rtc-node": "^0.13.34",
    "chrono-node": "2.10.1",
    "livekit-server-sdk": "^2.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "vite": "8.2.1"
    }
  }
}
