{
  "name": "abita_agent",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js start",
    "download-files": "livekit-agents download-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@livekit/agents": "1.5.5",
    "@livekit/agents-plugin-assemblyai": "1.5.5",
    "@livekit/agents-plugin-baseten": "1.5.5",
    "@livekit/agents-plugin-rime": "1.5.5",
    "@livekit/rtc-node": "^0.13.31",
    "livekit-server-sdk": "^2.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
